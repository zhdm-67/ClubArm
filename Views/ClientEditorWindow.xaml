<Window x:Class="ClubArm.Views.ClientEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование клиента" Height="300" Width="400"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="ФИО:"/>
        <TextBox x:Name="txtFullName" Margin="0,5"/>
        <TextBlock Text="Телефон:"/>
        <TextBox x:Name="txtPhone" Margin="0,5"/>
        <TextBlock Text="Скидка (%)"/>
        <TextBox x:Name="txtDiscount" Margin="0,5"/>
        <Button Content="Сохранить" Click="Save_Click" Width="100" Margin="0,20,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>