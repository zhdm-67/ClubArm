<Window x:Class="ClubArm.Views.StartSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запуск сессии" Height="300" Width="400"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Клиент:" FontWeight="Bold" Margin="0,5"/>
        <ComboBox x:Name="cmbClient" DisplayMemberPath="FullName" Margin="0,5"/>

        <TextBlock Text="Компьютер:" FontWeight="Bold" Margin="0,5"/>
        <ComboBox x:Name="cmbComputer" DisplayMemberPath="Name" Margin="0,5"/>

        <TextBlock Text="Тариф:" FontWeight="Bold" Margin="0,5"/>
        <ComboBox x:Name="cmbTariff" DisplayMemberPath="Name" Margin="0,5"/>

        <Button Content="Запустить" Click="Start_Click" Width="100" Height="30" Margin="0,20,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>