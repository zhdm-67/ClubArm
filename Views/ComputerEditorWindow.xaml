<Window x:Class="ClubArm.Views.ComputerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование компьютера" Height="279" Width="400"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Название:"/>
        <TextBox x:Name="txtName" Margin="0,5"/>
        <TextBlock Text="Статус:"/>
        <ComboBox x:Name="cmbStatus" Margin="0,5">
            <ComboBoxItem Content="Free"/>
            <ComboBoxItem Content="Occupied"/>
            <ComboBoxItem Content="Blocked"/>
            <ComboBoxItem Content="Maintenance"/>
        </ComboBox>
        <TextBlock Text="Конфигурация:"/>
        <TextBox x:Name="txtConfig" Margin="0,5" Height="60" TextWrapping="Wrap"/>
        <Button Content="Сохранить" Click="Save_Click" Width="100" Margin="0,20,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>