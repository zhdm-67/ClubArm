<UserControl x:Class="ClubArm.Views.ComputersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0">
            <Button Content="Добавить" Command="{Binding AddCommand}" Margin="2" Width="80"/>
            <Button Content="Изменить" Command="{Binding EditCommand}" Margin="2" Width="80"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="2" Width="80"/>
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="2" Width="80"/>
            <Button Content="Запустить сессию" Command="{Binding StartSessionCommand}" Margin="2" Width="120" Background="LightGreen"/>
            <Button Content="Завершить сессию" Command="{Binding StopSessionCommand}" Margin="2" Width="120" Background="LightCoral"/>
        </StackPanel>

        <!-- Список компьютеров в виде таблицы -->
        <ListView Grid.Row="1" ItemsSource="{Binding Computers}" SelectedItem="{Binding SelectedComputer}" Margin="5">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Статус" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="12" Height="12" Margin="0,0,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Free">
                                                    <Setter Property="Fill" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                    <Setter Property="Fill" Value="Orange"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Blocked">
                                                    <Setter Property="Fill" Value="Red"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                    <Setter Property="Fill" Value="Purple"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Название ПК" DisplayMemberBinding="{Binding Name}" Width="100"/>
                    <GridViewColumn Header="Статус (текст)" DisplayMemberBinding="{Binding Status}" Width="100"/>
                    <GridViewColumn Header="Клиент" DisplayMemberBinding="{Binding ClientName}" Width="150"/>
                    <GridViewColumn Header="Тариф" DisplayMemberBinding="{Binding TariffName}" Width="100"/>
                    <GridViewColumn Header="Время начала" DisplayMemberBinding="{Binding StartTime}" Width="100"/>
                    <GridViewColumn Header="Длительность" DisplayMemberBinding="{Binding Duration}" Width="100"/>
                    <GridViewColumn Header="Баланс клиента" DisplayMemberBinding="{Binding ClientBalance}" Width="100"/>
                    <GridViewColumn Header="Списано за сессию" DisplayMemberBinding="{Binding TotalCost, StringFormat={}{0:F2}}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>