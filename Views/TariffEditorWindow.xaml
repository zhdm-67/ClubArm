<Window x:Class="ClubArm.Views.TariffEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование тарифа" Height="400" Width="400"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Название:"/>
        <TextBox x:Name="txtName" Margin="0,5"/>
        <TextBlock Text="Тип тарифа:"/>
        <ComboBox x:Name="cmbType" Margin="0,5" SelectionChanged="CmbType_SelectionChanged">
            <ComboBoxItem>Поминутный</ComboBoxItem>
            <ComboBoxItem>Ночной</ComboBoxItem>
            <ComboBoxItem>Пакетный</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Цена за минуту (BYN):"/>
        <TextBox x:Name="txtPricePerMinute" Margin="0,5"/>
        <StackPanel x:Name="pnlPackage" Visibility="Collapsed">
            <TextBlock Text="Пакет минут (только для пакетного):"/>
            <TextBox x:Name="txtPackageMinutes" Margin="0,5"/>
            <TextBlock Text="Цена пакета (BYN):"/>
            <TextBox x:Name="txtPackagePrice" Margin="0,5"/>
        </StackPanel>
        <Button Content="Сохранить" Click="Save_Click" Width="100" Margin="0,20,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>