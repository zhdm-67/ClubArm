<Window x:Class="ClubArm.Views.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="250" Width="300"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Название:"/>
        <TextBox x:Name="txtName" Margin="0,5"/>
        <TextBlock Text="Цена:"/>
        <TextBox x:Name="txtPrice" Margin="0,5"/>
        <TextBlock Text="Остаток:"/>
        <TextBox x:Name="txtStock" Margin="0,5"/>
        <Button Content="Сохранить" Click="Save_Click" Width="100" Margin="0,20,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>