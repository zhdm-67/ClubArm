<UserControl x:Class="ClubArm.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClubArm.Converters">
    <UserControl.Resources>
        <converters:StockToColorConverter x:Key="StockToColorConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0">
            <Button Content="Добавить" Command="{Binding AddCommand}" Margin="2" Width="80"/>
            <Button Content="Изменить" Command="{Binding EditCommand}" Margin="2" Width="80"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Margin="2" Width="80"/>
            <Button Content="Обновить" Command="{Binding RefreshCommand}" Margin="2" Width="80"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="5" Padding="3" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="SearchBox" Width="200" Margin="5,0" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Поиск по названию товара"/>
                <Button Content="Очистить" Command="{Binding ClearSearchCommand}" Margin="5,0" Width="70"/>
            </StackPanel>
        </Border>

        <ListView Grid.Row="2" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" Margin="5">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="200"/>
                    <GridViewColumn Header="Цена (BYN)" DisplayMemberBinding="{Binding Price, StringFormat={}{0:F2}}" Width="100"/>
                    <GridViewColumn Header="Остаток" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Stock}" 
                                           Foreground="{Binding Stock, Converter={StaticResource StockToColorConverter}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>