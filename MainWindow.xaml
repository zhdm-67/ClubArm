<Window x:Class="ClubArm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClubArm.ViewModels"
        xmlns:views="clr-namespace:ClubArm.Views"
        Title="АРМ администратора клуба" Height="600" Width="900">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ComputersViewModel}">
            <views:ComputersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
            <views:ClientsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TariffsViewModel}">
            <views:TariffsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="150" Margin="5">
            <Button Content="Компьютеры" Command="{Binding ShowComputersCommand}" Margin="0,5" Height="30"/>
            <Button Content="Клиенты" Command="{Binding ShowClientsCommand}" Margin="0,5" Height="30"/>
            <Button Content="Тарифы" Command="{Binding ShowTariffsCommand}" Margin="0,5" Height="30"/>
            <Button Content="Товары" Command="{Binding ShowProductsCommand}" Margin="0,5" Height="30"/>
            <Button Content="Отчёты" Command="{Binding ShowReportsCommand}" Margin="0,5" Height="30"/>
        </StackPanel>
        <ContentControl Content="{Binding CurrentView}" Margin="5"/>
    </DockPanel>
</Window>